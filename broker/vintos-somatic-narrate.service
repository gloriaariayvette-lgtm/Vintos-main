[Unit]
Description=Vintos somatic-session narration — seeds the morning unresolved somatic thread
After=network-online.target vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.vintos/vintos.env
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/somatic_narrate.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace %h/.vintos/logs
