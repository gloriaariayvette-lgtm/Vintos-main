[Unit]
Description=Vintos robot bridge (the Pi body reports here; his commands queue here)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.vintos/secrets/robot.env
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/robot_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace -%h/Vintos

[Install]
WantedBy=default.target
