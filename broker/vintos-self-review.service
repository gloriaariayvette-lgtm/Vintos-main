[Unit]
Description=Vintos continuous self-review signal detector
After=network-online.target vintos-server.service vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/self_review.py watch
Restart=always
RestartSec=12
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Aegis is deliberately split: most organs live under workspace/scripts while
# several live twins are under ~/Vintos.  The '-' makes that second tree legal
# to omit on another host.  Never name workspace/bin: it does not exist on
# Aegis, and systemd would fail the service before Python started.
ReadWritePaths=%h/.vintos/workspace -%h/Vintos

[Install]
WantedBy=default.target
