[Unit]
Description=Vintos continuous self-review signal detector
After=network-online.target vintos-server.service vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/self_review.py watch
Restart=always
RestartSec=12
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace/memory %h/.vintos/workspace/scripts %h/.vintos/workspace/bin %h/.vintos/workspace/broker/tests

[Install]
WantedBy=default.target
