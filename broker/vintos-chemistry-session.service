[Unit]
Description=Vintos scheduled Chemistry Lab frontier session
After=network-online.target vintos-chemistry-lab.service vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.vintos/vintos.env
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/chemistry_session.py run
# A session takes minutes. One started 18 October 02:20 UTC was still running hours later with no limit at all
# (oneshot defaults to infinity); a stuck session also blocks the next four timer runs.
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace %h/.vintos/logs
