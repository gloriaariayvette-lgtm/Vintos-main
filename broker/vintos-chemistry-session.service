[Unit]
Description=Vintos scheduled Chemistry Lab frontier session
After=network-online.target vintos-chemistry-lab.service vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/chemistry_session.py run
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace %h/.vintos/logs
