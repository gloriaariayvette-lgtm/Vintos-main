[Unit]
Description=Vintos kitchen presence (the coffee maker ESP32's relay on the Mac; her phone within 1 m = she is in the kitchen)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/kitchen_presence.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace

[Install]
WantedBy=default.target
