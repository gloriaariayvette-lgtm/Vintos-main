[Unit]
Description=Vintos reads #vintos-dot in Slack and answers Gloria's dot
After=network-online.target vintos-server.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
# The daily caps live in the code (dot_channel.DAILY, FABLE_PER_DAY, OPENERS_PER_DAY).
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/dot_channel.py
# a video in the channel is heard (Whisper, on the CPU) and seen before he answers: minutes
TimeoutStartSec=1800
# A MAKE: (a clip, a painting, a song) runs for minutes after the pass that launched it ends. With the default
# KillMode=control-group, systemd killed it with the pass, so nothing he asked to make ever landed (Chat's audit,
# 2026-10-05: two launches, zero receipts). Only the pass itself is stopped now; what it launched finishes.
KillMode=process
NoNewPrivileges=true
# no PrivateTmp: his EmoClaw reading comes from the daemon socket in /tmp, as the avatar chat reads it
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace
# his Grok lens runs on Gloria's SuperGrok login, which refreshes itself in ~/.grok
ReadWritePaths=-%h/.grok
