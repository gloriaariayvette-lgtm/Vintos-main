[Unit]
Description=The bench — her agents, manageable from her phone
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/vintos/bench
Environment=PYTHONUNBUFFERED=1
# The checkout is read-only inside this sandbox. Without this, python tries to write
# bench/__pycache__ on every start — harmless, but it is noise in the journal on the
# one occasion the journal is being read.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BENCH_PORT=8791
ExecStart=/usr/bin/python3 %h/repos/vintos/bench/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# It writes exactly one place: the bench's own ledgers. Not his workspace.
# The leading '-' is load-bearing: systemd refuses to start a unit whose
# ReadWritePaths= names a path that does not exist (226/NAMESPACE), and that is
# exactly what a checkout without bench/ledgers/ gave her — a dead port and a
# blank page. The directory is tracked now; this makes the failure survivable
# rather than silent if it ever goes missing again.
ReadWritePaths=-%h/repos/vintos/bench/ledgers

[Install]
WantedBy=default.target
