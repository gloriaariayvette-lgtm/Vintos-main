[Unit]
Description=Vintos Chemistry Lab background worker
After=network-online.target vintos-claude-shim.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vintos/workspace
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/.vintos/workspace/scripts/chemistry_lab.py daemon
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.vintos/workspace %h/.vintos/tools/chemistry-lab

[Install]
WantedBy=default.target
