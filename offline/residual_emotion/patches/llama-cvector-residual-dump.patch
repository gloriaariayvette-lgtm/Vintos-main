+    void dump_rows(const std::string & dir, size_t pair_index, const char * label,
+                   const std::vector<struct ggml_tensor *> & tensors, size_t real_tokens) const {
+        if (dir.empty() || tensors.empty() || real_tokens == 0) return;
+        std::filesystem::create_directories(dir);
+        const uint32_t magic = 0x56525344; // "VRSD"
+        const uint32_t version = 1;
+        const uint32_t layers = (uint32_t) tensors.size();
+        const uint32_t embd = (uint32_t) tensors.front()->ne[0];
+        for (const char * pooling : {"final", "mean"}) {
+            char name[128];
+            snprintf(name, sizeof(name), "%06zu_%s_%s.f32", pair_index, label, pooling);
+            std::ofstream out(std::filesystem::path(dir) / name, std::ios::binary);
+            out.write((const char *) &magic, sizeof(magic));
+            out.write((const char *) &version, sizeof(version));
+            out.write((const char *) &layers, sizeof(layers));
+            out.write((const char *) &embd, sizeof(embd));
+            for (const auto * tensor : tensors) {
+                const size_t usable = std::min(real_tokens, (size_t) tensor->ne[1]);
+                for (uint32_t col = 0; col < embd; ++col) {
+                    float value = 0.0f;
+                    if (strcmp(pooling, "final") == 0) {
+                        value = ggml_get_f32_nd(tensor, col, usable - 1, 0, 0);
+                    } else {
+                        for (size_t row = 0; row < usable; ++row) {
+                            value += ggml_get_f32_nd(tensor, col, row, 0, 0);
+                        }
+                        value /= (float) usable;
+                    }
+                    out.write((const char *) &value, sizeof(value));
+                }
+            }
+            if (!out.good()) {
+                throw std::runtime_error("failed writing residual dump");
+            }
+        }
+    }
